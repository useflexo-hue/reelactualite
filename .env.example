# Server-only — same values as above, read at runtime (not bundled).
SUPABASE_URL=https://drtqfhzmaianmhiiqgxa.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_1jHcGqlpBCh8QABRccn7oQ_iyqfb9VN

# Secret — server-side admin client (bypasses RLS). Get this from
# Supabase dashboard -> Project Settings -> API -> service_role key.
# Required only for admin routes (social publish, exports, etc.) - never
# expose this value client-side or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Host port to publish on the VPS (adjust if it collides with another app).
HOST_PORT=3010
