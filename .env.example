VITE_SUPABASE_URL=https://drtqfhzmaianmhiiqgxa.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1jHcGqlpBCh8QABRccn7oQ_iyqfb9VN
